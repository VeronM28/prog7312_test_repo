<script>
    // Add animation to progress bars when they come into view
    document.addEventListener('DOMContentLoaded', function() {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.animation = 'fillProgress 1s ease-out forwards';
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.progress-bar-fill').forEach(bar => {
            observer.observe(bar);
        });
    });
</script>

@functions {
    public class StatusBadgeInfo
    {
        public string Background { get; set; }
        public string Color { get; set; }
        public string Icon { get; set; }
    }

    public class PriorityBadgeInfo
    {
        public string Background { get; set; }
        public string Color { get; set; }
        public string Icon { get; set; }
    }

    public StatusBadgeInfo GetReportStatusInfo(string status)
    {
        return status switch
        {
            "Pending" => new StatusBadgeInfo
            {
                Background = "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)",
                Color = "white",
                Icon = "hourglass-split"
            },
            "In-Progress" => new StatusBadgeInfo
            {
                Background = "linear-gradient(135deg, #3b82f6 0%, #2563eb 100%)",
                Color = "white",
                Icon = "arrow-repeat"
            },
            "Completed" => new StatusBadgeInfo
            {
                Background = "linear-gradient(135deg, #10b981 0%, #059669 100%)",
                Color = "white",
                Icon = "check-circle-fill"
            },
            _ => new StatusBadgeInfo
            {
                Background = "#6c757d",
                Color = "white",
                Icon = "question-circle"
            }
        };
    }

    public StatusBadgeInfo GetServiceRequestStatusInfo(RequestStatus status)
    {
        return status switch
        {
            RequestStatus.Submitted => new StatusBadgeInfo
            {
                Background = "linear-gradient(135deg, #06b6d4 0%, #0891b2 100%)",
                Color = "white",
                Icon = "send-check"
            },
            RequestStatus.InProgress => new StatusBadgeInfo
            {
                Background = "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)",
                Color = "white",
                Icon = "arrow-repeat"
            },
            RequestStatus.UnderReview => new StatusBadgeInfo
            {
                Background = "linear-gradient(135deg, #6366f1 0%, #4f46e5 100%)",
                Color = "white",
                Icon = "search"
            },
            RequestStatus.Completed => new StatusBadgeInfo
            {
                Background = "linear-gradient(135deg, #10b981 0%, #059669 100%)",
                Color = "white",
                Icon = "check-circle-fill"
            },
            RequestStatus.Cancelled => new StatusBadgeInfo
            {
                Background = "linear-gradient(135deg, #ef4444 0%, #dc2626 100%)",
                Color = "white",
                Icon = "x-circle-fill"
            },
            _ => new StatusBadgeInfo
            {
                Background = "#6c757d",
                Color = "white",
                Icon = "question-circle"
            }
        };
    }

    public PriorityBadgeInfo GetPriorityBadge(int priorityScore)
    {
        if (priorityScore >= 150)
        {
            return new PriorityBadgeInfo
            {
                Background = "linear-gradient(135deg, #ef4444 0%, #dc2626 100%)",
                Color = "white",
                Icon = "exclamation-triangle-fill"
            };
        }
        else if (priorityScore >= 100)
        {
            return new PriorityBadgeInfo
            {
                Background = "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)",
                Color = "white",
                Icon = "exclamation-circle-fill"
            };
        }
        else
        {
            return new PriorityBadgeInfo
            {
                Background = "linear-gradient(135deg, #3b82f6 0%, #2563eb 100%)",
                Color = "white",
                Icon = "info-circle-fill"
            };
        }
    }
}
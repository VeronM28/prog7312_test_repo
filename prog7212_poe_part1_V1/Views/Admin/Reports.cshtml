@model prog7212_poe_part1_V1.ViewModels.AdminReportsViewModel

@{
    ViewData["Title"] = "Manage Reports";
}

<div class="modern-admin-reports-container">
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <div class="header-content">
                <div class="header-icon">
                    <i class="bi bi-folder-open"></i>
                </div>
                <div class="header-text">
                    <h1>Manage Reports</h1>
                    <p>Review, filter, and update report statuses</p>
                </div>
            </div>
        </div>

        <!-- Main Card -->
        <div class="reports-card">
            <!-- Card Header with Total Count -->
            <div class="card-header-modern">
                <div class="header-left">
                    <h2><i class="bi bi-list-check"></i> All Reports</h2>
                    <p>Manage and track all submitted reports</p>
                </div>
                <div class="total-badge">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>@Model.Reports.Count</span>
                    <small>Total Reports</small>
                </div>
            </div>

            <!-- Filters Section -->
            <div class="filters-section">
                <form method="get" class="filters-form">
                    <div class="filter-group">
                        <label for="category" class="filter-label">
                            <i class="bi bi-tag"></i>
                            <span>Category</span>
                        </label>
                        <div class="select-wrapper">
                            <select name="category" id="category" class="filter-select">
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category" selected="@(category == Model.SelectedCategory)">
                                        @category
                                    </option>
                                }
                            </select>
                            <i class="bi bi-chevron-down select-icon"></i>
                        </div>
                    </div>

                    <div class="filter-group">
                        <label for="status" class="filter-label">
                            <i class="bi bi-flag"></i>
                            <span>Status</span>
                        </label>
                        <div class="select-wrapper">
                            <select name="status" id="status" class="filter-select">
                                @foreach (var status in Model.Statuses)
                                {
                                    <option value="@status" selected="@(status == Model.SelectedStatus)">
                                        @status
                                    </option>
                                }
                            </select>
                            <i class="bi bi-chevron-down select-icon"></i>
                        </div>
                    </div>

                    <div class="filter-actions">
                        <button type="submit" class="btn-filter">
                            <i class="bi bi-funnel"></i>
                            <span>Apply Filters</span>
                        </button>
                        <a href="@Url.Action("Reports")" class="btn-clear">
                            <i class="bi bi-x-circle"></i>
                            <span>Clear</span>
                        </a>
                    </div>
                </form>
            </div>

            <!-- Reports Table -->
            <div class="table-section">
                @if (Model.Reports.Any())
                {
                    <div class="table-responsive">
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Report ID</th>
                                    <th>User</th>
                                    <th>Category</th>
                                    <th>Location</th>
                                    <th>Status</th>
                                    <th>Submitted</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var report in Model.Reports)
                                {
                                    <tr class="table-row">
                                        <td>
                                            <div class="report-id">
                                                <i class="bi bi-hash"></i>
                                                <strong>@report.Id</strong>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="user-info">
                                                <div class="user-avatar">
                                                    <i class="bi bi-person"></i>
                                                </div>
                                                <span>@(report.User?.UserName ?? "Unknown User")</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="category-badge">
                                                <i class="bi bi-tag-fill"></i>
                                                @report.Category
                                            </span>
                                        </td>
                                        <td>
                                            <div class="location-info">
                                                <i class="bi bi-geo-alt-fill"></i>
                                                <span>@report.Location</span>
                                            </div>
                                        </td>
                                        <td>
                                            @{
                                                var statusInfo = GetStatusInfo(report.Status);
                                            }
                                            <span class="status-badge" style="background: @statusInfo.Background; color: @statusInfo.Color;">
                                                <i class="bi bi-@statusInfo.Icon"></i>
                                                @report.Status
                                            </span>
                                        </td>
                                        <td>
                                            <div class="date-info">
                                                <i class="bi bi-calendar-event"></i>
                                                <div class="date-content">
                                                    <span class="date">@report.DateSubmitted.ToString("MMM dd, yyyy")</span>
                                                    <span class="time">@report.DateSubmitted.ToString("HH:mm")</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="action-buttons">
                                                <!-- Status Update Dropdown -->
                                                <div class="dropdown-wrapper">
                                                    <button class="btn-status-update" onclick="toggleDropdown(this)">
                                                        <i class="bi bi-arrow-repeat"></i>
                                                        <span>Update</span>
                                                        <i class="bi bi-chevron-down"></i>
                                                    </button>
                                                    <div class="dropdown-menu-custom">
                                                        <form method="post" asp-action="UpdateStatus" class="status-form" onsubmit="return confirmUpdate(event, '@report.Id', 'Pending')">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="reportId" value="@report.Id" />
                                                            <input type="hidden" name="status" value="Pending" />
                                                            <button type="submit" class="dropdown-item @(report.Status == "Pending" ? "disabled" : "")" @(report.Status == "Pending" ? "disabled" : "")>
                                                                <i class="bi bi-hourglass-split" style="color: #f59e0b;"></i>
                                                                <span>Pending</span>
                                                            </button>
                                                        </form>
                                                        <form method="post" asp-action="UpdateStatus" class="status-form" onsubmit="return confirmUpdate(event, '@report.Id', 'In-Progress')">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="reportId" value="@report.Id" />
                                                            <input type="hidden" name="status" value="In-Progress" />
                                                            <button type="submit" class="dropdown-item @(report.Status == "In-Progress" ? "disabled" : "")" @(report.Status == "In-Progress" ? "disabled" : "")>
                                                                <i class="bi bi-arrow-repeat" style="color: #3b82f6;"></i>
                                                                <span>In-Progress</span>
                                                            </button>
                                                        </form>
                                                        <form method="post" asp-action="UpdateStatus" class="status-form" onsubmit="return confirmUpdate(event, '@report.Id', 'Completed')">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="reportId" value="@report.Id" />
                                                            <input type="hidden" name="status" value="Completed" />
                                                            <button type="submit" class="dropdown-item @(report.Status == "Completed" ? "disabled" : "")" @(report.Status == "Completed" ? "disabled" : "")>
                                                                <i class="bi bi-check-circle-fill" style="color: #10b981;"></i>
                                                                <span>Completed</span>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>

                                                <!-- View Button -->
                                                <a href="@Url.Action("ReportDetails", new { id = report.Id })" class="btn-view">
                                                    <i class="bi bi-eye"></i>
                                                    <span>View</span>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <!-- Empty State -->
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="bi bi-inbox"></i>
                        </div>
                        <h3>No Reports Found</h3>
                        <p>No reports match the selected filters. Try adjusting your filter criteria.</p>
                        <a href="@Url.Action("Reports")" class="btn-primary-modern">
                            <i class="bi bi-arrow-clockwise"></i>
                            <span>View All Reports</span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>

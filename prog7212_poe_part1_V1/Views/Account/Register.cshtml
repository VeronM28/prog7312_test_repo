@model prog7212_poe_part1_V1.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<!-- Import Google Font -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --primary-color: #6366f1;
        --primary-dark: #4f46e5;
        --secondary-color: #8b5cf6;
        --success-color: #10b981;
        --danger-color: #ef4444;
        --text-primary: #1e293b;
        --text-secondary: #64748b;
        --border-color: #e2e8f0;
    }

    * {
        font-family: 'Inter', sans-serif;
    }

    /* Fixed Background */
    body {
        position: relative;
        min-height: 100vh;
        margin: 0;
        padding: 0;
    }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url('/images/park.jpg') no-repeat center center;
            background-size: cover;
            z-index: -1;
        }

    /* Register Page Container */
    .register-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    /* Modern Register Card */
    .register-card {
        background: rgba(255, 255, 255, 0.98);
        border-radius: 1.5rem;
        padding: 3rem 2.5rem;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
        backdrop-filter: blur(20px);
        max-width: 500px;
        width: 100%;
        border: 1px solid rgba(255, 255, 255, 0.3);
        animation: slideUp 0.5s ease;
    }

    @@keyframes slideUp {
        from

    {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* Header Section */
    .register-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .register-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        border-radius: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        box-shadow: 0 8px 20px rgba(99, 102, 241, 0.3);
    }

        .register-icon i {
            font-size: 2rem;
            color: white;
        }

    .register-card h2 {
        color: var(--text-primary);
        font-weight: 700;
        font-size: 1.875rem;
        margin-bottom: 0.5rem;
    }

    .register-subtitle {
        color: var(--text-secondary);
        font-size: 0.95rem;
        font-weight: 500;
    }

    /* Validation Summary */
    .validation-summary {
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.1), rgba(220, 38, 38, 0.05));
        border-left: 4px solid var(--danger-color);
        border-radius: 0.75rem;
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
    }

        .validation-summary ul {
            margin: 0;
            padding-left: 1.25rem;
            color: var(--danger-color);
            font-weight: 500;
        }

    /* Form Groups */
    .form-group-modern {
        margin-bottom: 1.5rem;
    }

    .form-label-modern {
        display: block;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-secondary);
        font-size: 1.1rem;
        pointer-events: none;
        transition: color 0.3s ease;
    }

    .form-control-modern {
        width: 100%;
        padding: 0.875rem 1rem 0.875rem 3rem;
        border: 2px solid var(--border-color);
        border-radius: 0.75rem;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        background: white;
        color: var(--text-primary);
    }

        .form-control-modern:focus {
            outline: none;
            border-color: var(--primary-color);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        }

            .form-control-modern:focus + .input-icon {
                color: var(--primary-color);
            }

        .form-control-modern::placeholder {
            color: #94a3b8;
        }

    /* Validation Messages */
    .field-validation-error {
        display: block;
        color: var(--danger-color);
        font-size: 0.875rem;
        margin-top: 0.5rem;
        font-weight: 500;
    }

    /* Password Strength Indicator */
    .password-strength {
        margin-top: 0.5rem;
        font-size: 0.875rem;
    }

    .strength-bar {
        height: 4px;
        background: var(--border-color);
        border-radius: 2px;
        margin-top: 0.5rem;
        overflow: hidden;
    }

    .strength-fill {
        height: 100%;
        transition: all 0.3s ease;
        border-radius: 2px;
    }

    /* Submit Button */
    .btn-register {
        width: 100%;
        padding: 0.875rem;
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        border: none;
        border-radius: 0.75rem;
        color: white;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        margin-top: 0.5rem;
    }

        .btn-register:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(99, 102, 241, 0.4);
        }

        .btn-register:active {
            transform: translateY(0);
        }

    /* Login Link */
    .login-link {
        text-align: center;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border-color);
    }

        .login-link p {
            color: var(--text-secondary);
            font-size: 0.95rem;
            margin: 0;
        }

        .login-link a {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 600;
            transition: all 0.2s ease;
        }

            .login-link a:hover {
                color: var(--primary-dark);
                text-decoration: underline;
            }

    /* Success Message */
    .success-message {
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(5, 150, 105, 0.05));
        border-left: 4px solid var(--success-color);
        border-radius: 0.75rem;
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
        color: var(--success-color);
        font-weight: 500;
    }

    /* Responsive */
    @@media (max-width: 576px) {
        .register-card

    {
        padding: 2rem 1.5rem;
    }

    .register-card h2 {
        font-size: 1.5rem;
    }

    .register-icon {
        width: 60px;
        height: 60px;
    }

        .register-icon i {
            font-size: 1.75rem;
        }

    }
</style>

<div class="register-page">
    <div class="register-card">
        <!-- Header -->
        <div class="register-header">
            <div class="register-icon">
                <i class="bi bi-person-plus"></i>
            </div>
            <h2>Create Account</h2>
            <p class="register-subtitle">Join our community today</p>
        </div>

        <!-- Register Form -->
        <form asp-action="Register" method="post">
            <!-- Validation Summary -->
            @if (ViewData.ModelState.ErrorCount > 0)
            {
                <div class="validation-summary">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <!-- Full Name Field -->
            <div class="form-group-modern">
                <label asp-for="FullName" class="form-label-modern">Full Name</label>
                <div class="input-wrapper">
                    <input asp-for="FullName" class="form-control-modern" placeholder="Enter your full name" />
                    <i class="bi bi-person input-icon"></i>
                </div>
                <span asp-validation-for="FullName" class="field-validation-error"></span>
            </div>

            <!-- Email Field -->
            <div class="form-group-modern">
                <label asp-for="Email" class="form-label-modern">Email Address</label>
                <div class="input-wrapper">
                    <input asp-for="Email" class="form-control-modern" placeholder="name@example.com" />
                    <i class="bi bi-envelope input-icon"></i>
                </div>
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <!-- Password Field -->
            <div class="form-group-modern">
                <label asp-for="Password" class="form-label-modern">Password</label>
                <div class="input-wrapper">
                    <input asp-for="Password" type="password" class="form-control-modern" placeholder="Enter a strong password" id="passwordInput" />
                    <i class="bi bi-lock input-icon"></i>
                </div>
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <!-- Confirm Password Field -->
            <div class="form-group-modern">
                <label asp-for="ConfirmPassword" class="form-label-modern">Confirm Password</label>
                <div class="input-wrapper">
                    <input asp-for="ConfirmPassword" type="password" class="form-control-modern" placeholder="Re-enter your password" />
                    <i class="bi bi-lock-fill input-icon"></i>
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-register">
                <i class="bi bi-check-circle"></i>
                Create Account
            </button>

            <!-- Login Link -->
            <div class="login-link">
                <p>
                    Already have an account?
                    <a asp-controller="Account" asp-action="Login">Sign in here</a>
                </p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
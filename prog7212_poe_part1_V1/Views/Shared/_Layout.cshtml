<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - prog7212_poe_part1_V1</title>
    <script type="importmap"></script>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/prog7312_poe_part1_V1.styles.css" asp-append-version="true" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #6366f1;
            --primary-dark: #4f46e5;
            --secondary-color: #8b5cf6;
            --success-color: #10b981;
            --danger-color: #ef4444;
            --warning-color: #f59e0b;
            --info-color: #3b82f6;
            --text-primary: #1e293b;
            --text-secondary: #64748b;
            --border-color: #e2e8f0;
        }

        * {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        body {
            padding-top: 80px;
            background: #f8fafc;
        }

        /* Modern Navbar */
        .modern-navbar {
            background: white !important;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            border-bottom: 1px solid var(--border-color);
            padding: 0.75rem 0;
            transition: all 0.3s ease;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.35rem;
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
        }

            .navbar-brand:hover {
                transform: translateY(-2px);
            }

            .navbar-brand i {
                font-size: 1.5rem;
                background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

        /* Navigation Links */
        .navbar-nav .nav-link {
            color: var(--text-primary);
            font-weight: 500;
            padding: 0.5rem 1rem;
            margin: 0 0.25rem;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .navbar-nav .nav-link:hover {
                background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(139, 92, 246, 0.1));
                color: var(--primary-color);
                transform: translateY(-2px);
            }

            .navbar-nav .nav-link.active {
                background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
                color: white !important;
                box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
            }

            .navbar-nav .nav-link i {
                font-size: 1.1rem;
            }

        /* User Dropdown */
        .nav-link.dropdown-toggle {
            background: linear-gradient(135deg, #f8fafc, #f1f5f9);
            border: 2px solid var(--border-color);
            padding: 0.5rem 1rem;
            border-radius: 0.75rem;
            font-weight: 600;
            color: var(--text-primary);
        }

            .nav-link.dropdown-toggle:hover {
                border-color: var(--primary-color);
                background: linear-gradient(135deg, rgba(99, 102, 241, 0.05), rgba(139, 92, 246, 0.05));
            }

            .nav-link.dropdown-toggle i {
                font-size: 1.25rem;
            }

            /* Admin Dropdown */
            .nav-link.dropdown-toggle.admin-toggle {
                background: linear-gradient(135deg, #fef3c7, #fde68a);
                border: 2px solid var(--warning-color);
                color: #92400e;
            }

                .nav-link.dropdown-toggle.admin-toggle:hover {
                    background: linear-gradient(135deg, #fde68a, #fcd34d);
                }

        /* Dropdown Menu */
        .dropdown-menu {
            border: none;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
            border-radius: 0.75rem;
            padding: 0.5rem;
            margin-top: 0.5rem;
            min-width: 240px;
        }

        .dropdown-item {
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            margin-bottom: 0.25rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            transition: all 0.2s ease;
        }

            .dropdown-item:hover {
                background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(139, 92, 246, 0.1));
                color: var(--primary-color);
                transform: translateX(4px);
            }

            .dropdown-item i {
                font-size: 1.1rem;
                width: 20px;
            }

            .dropdown-item.text-danger:hover {
                background: linear-gradient(135deg, rgba(239, 68, 68, 0.1), rgba(220, 38, 38, 0.1));
                color: var(--danger-color) !important;
            }

        .dropdown-divider {
            margin: 0.5rem 0;
            border-color: var(--border-color);
        }

        /* Auth Buttons */
        .nav-link.login {
            color: var(--primary-color);
            font-weight: 600;
        }

        .nav-link.register {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white !important;
            font-weight: 600;
            padding: 0.5rem 1.5rem;
            border-radius: 0.75rem;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        }

            .nav-link.register:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);
            }

        /* Navbar Toggler */
        .navbar-toggler {
            border: 2px solid var(--border-color);
            border-radius: 0.5rem;
            padding: 0.5rem 0.75rem;
        }

            .navbar-toggler:focus {
                box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
            }

        /* Main Content */
        .main-content {
            padding-top: 2rem;
            padding-bottom: 2rem;
        }

        /* Footer */
        .site-footer {
            background: white;
            border-top: 2px solid var(--border-color);
            padding: 2rem 0;
            margin-top: 4rem;
            text-align: center;
            color: var(--text-secondary);
            font-weight: 500;
        }

        /* Active Link Indicators */
        .navbar-nav .nav-link.dashboard.active {
            background: linear-gradient(135deg, #10b981, #059669);
        }

        .navbar-nav .nav-link.events.active {
            background: linear-gradient(135deg, #f59e0b, #d97706);
        }

        .navbar-nav .nav-link.reports.active {
            background: linear-gradient(135deg, #ef4444, #dc2626);
        }

        .navbar-nav .nav-link.service-requests.active {
            background: linear-gradient(135deg, #3b82f6, #2563eb);
        }

        /* Responsive */
        @@media (max-width: 991px) {
            .navbar-collapse

        {
            background: white;
            padding: 1rem;
            border-radius: 0.75rem;
            margin-top: 1rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

        .navbar-nav .nav-link {
            margin: 0.25rem 0;
        }

        .nav-link.dropdown-toggle {
            margin-top: 0.5rem;
        }

        }

        /* Smooth Scroll */
        html {
            scroll-behavior: smooth;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg modern-navbar fixed-top">
            <div class="container">
                <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-building"></i>
                    <span>Municipality Portal</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link dashboard @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")"
                                   asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-house-door"></i>
                                    <span>Dashboard</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link events @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Events" ? "active" : "")"
                                   asp-controller="Events" asp-action="Index">
                                    <i class="bi bi-calendar-event"></i>
                                    <span>Events & Announcements</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link reports @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Report" ? "active" : "")"
                                   asp-controller="Report" asp-action="MyReports">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    <span>My Reports</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link service-requests @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ServiceRequest" ? "active" : "")"
                                   asp-controller="ServiceRequest" asp-action="Status">
                                    <i class="bi bi-clipboard-check"></i>
                                    <span>Service Requests</span>
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle admin-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-shield-check"></i>
                                        <span>Admin Tools</span>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">
                                                <i class="bi bi-speedometer2"></i>
                                                <span>Dashboard</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Reports">
                                                <i class="bi bi-file-earmark-text"></i>
                                                <span>Manage Reports</span>
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Reports" asp-route-status="Pending">
                                                <i class="bi bi-clock-history"></i>
                                                <span>Pending Reports</span>
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="CreateEvent">
                                                <i class="bi bi-plus-circle"></i>
                                                <span>Create Event</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Events">
                                                <i class="bi bi-calendar-event"></i>
                                                <span>Manage Events</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="ServiceRequests">
                                                <i class="bi bi-clipboard-check"></i>
                                                <span>Service Requests</span>
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i>
                                    <span>@(ViewBag.UserName ?? User.Identity.Name)</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            <i class="bi bi-person"></i>
                                            <span>Profile</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            <i class="bi bi-gear"></i>
                                            <span>Settings</span>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right"></i>
                                                <span>Logout</span>
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link login" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    <span>Login</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link register" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus"></i>
                                    <span>Register</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            <p class="mb-0">© 2025 Municipality Portal. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Add active class to current page
        document.addEventListener('DOMContentLoaded', function() {
            const currentPath = window.location.pathname.toLowerCase();
            const navLinks = document.querySelectorAll('.navbar-nav .nav-link');

            navLinks.forEach(link => {
                const href = link.getAttribute('href');
                if (href && currentPath.includes(href.toLowerCase())) {
                    link.classList.add('active');
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
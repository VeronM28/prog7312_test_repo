@model List<prog7212_poe_part1_V1.Models.ServiceRequestModel>
@{
    ViewData["Title"] = "Service Request Status";
}

<div class="modern-status-container">
    <div class="container">
        <!-- Page Header -->
        <div class="page-header">
            <div class="header-content">
                <div class="header-icon">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div class="header-text">
                    <h1>Service Request Status</h1>
                    <p>Track and monitor your service requests</p>
                </div>
            </div>
        </div>

        <!-- Success/Error Messages -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-modern alert-success">
                <i class="bi bi-check-circle-fill"></i>
                <div class="alert-content">
                    <strong>Success!</strong>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            </div>
        }

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert-modern alert-danger">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div class="alert-content">
                    <strong>Error!</strong>
                    <span>@ViewBag.ErrorMessage</span>
                </div>
            </div>
        }

        <!-- Requests Content -->
        @if (Model.Any())
        {
            <!-- Stats Summary -->
            <div class="stats-grid">
                @{
                    var totalRequests = Model.Count;
                    var submittedCount = Model.Count(r => r.Status == RequestStatus.Submitted);
                    var inProgressCount = Model.Count(r => r.Status == RequestStatus.InProgress);
                    var completedCount = Model.Count(r => r.Status == RequestStatus.Completed);
                }

                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);">
                        <i class="bi bi-list-check"></i>
                    </div>
                    <div class="stat-info">
                        <div class="stat-value">@totalRequests</div>
                        <div class="stat-label">Total Requests</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                        <i class="bi bi-send-check"></i>
                    </div>
                    <div class="stat-info">
                        <div class="stat-value">@submittedCount</div>
                        <div class="stat-label">Submitted</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                    <div class="stat-info">
                        <div class="stat-value">@inProgressCount</div>
                        <div class="stat-label">In Progress</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="stat-info">
                        <div class="stat-value">@completedCount</div>
                        <div class="stat-label">Completed</div>
                    </div>
                </div>
            </div>

            <!-- Requests Table Card -->
            <div class="table-card">
                <div class="table-card-header">
                    <div class="header-left">
                        <h2>Your Requests</h2>
                        <p>Showing @totalRequests request@(totalRequests != 1 ? "s" : "")</p>
                    </div>
                    <div class="header-right">
                        <a asp-action="Create" class="btn-primary-modern">
                            <i class="bi bi-plus-circle"></i>
                            <span>New Request</span>
                        </a>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th>Request ID</th>
                                <th>Title</th>
                                <th>Service Type</th>
                                <th>Status</th>
                                <th>Created Date</th>
                                <th>Last Updated</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model.OrderByDescending(r => r.CreatedDate))
                            {
                                <tr>
                                    <td>
                                        <div class="request-id">
                                            <i class="bi bi-hash"></i>
                                            <code>@request.RequestId.Substring(0, 8)</code>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="request-title">
                                            <strong>@request.Title</strong>
                                            <small>@request.Description.Substring(0, Math.Min(50, request.Description.Length))@(request.Description.Length > 50 ? "..." : "")</small>
                                        </div>
                                    </td>
                                    <td>
                                        @{
                                            var serviceTypeInfo = GetServiceTypeInfo(request.ServiceType);
                                        }
                                        <div class="service-type-badge">
                                            <i class="bi bi-@serviceTypeInfo.Icon"></i>
                                            <span>@serviceTypeInfo.Name</span>
                                        </div>
                                    </td>
                                    <td>
                                        @{
                                            var statusInfo = GetStatusInfo(request.Status);
                                        }
                                        <span class="status-badge" style="background: @statusInfo.Background; color: @statusInfo.Color;">
                                            <i class="bi bi-@statusInfo.Icon"></i>
                                            <span>@statusInfo.Name</span>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="date-info">
                                            <i class="bi bi-calendar-event"></i>
                                            <span>@request.CreatedDate.ToString("MMM dd, yyyy")</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="date-info">
                                            <i class="bi bi-clock"></i>
                                            <span>@(request.UpdatedDate?.ToString("MMM dd, yyyy") ?? "N/A")</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <button class="btn-icon" title="View Details" onclick="viewDetails('@request.RequestId')">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-inbox"></i>
                </div>
                <h3>No Service Requests Yet</h3>
                <p>You haven't submitted any service requests. Create your first request to get started!</p>
                <a asp-action="Create" class="btn-primary-modern">
                    <i class="bi bi-plus-circle"></i>
                    <span>Create First Request</span>
                </a>
            </div>
        }
    </div>
</div>

<style>
    :root {
        --primary-color: #6366f1;
        --primary-dark: #4f46e5;
        --primary-light: #818cf8;
        --secondary-color: #8b5cf6;
        --success-color: #10b981;
        --danger-color: #ef4444;
        --warning-color: #f59e0b;
        --info-color: #3b82f6;
        --bg-color: #f8fafc;
        --card-bg: #ffffff;
        --text-primary: #1e293b;
        --text-secondary: #64748b;
        --border-color: #e2e8f0;
        --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.07);
        --shadow-lg: 0 10px 25px rgba(0, 0, 0, 0.1);
    }

    .modern-status-container {
        background: var(--bg-color);
        min-height: 100vh;
        padding: 2rem 0 4rem;
    }

    /* Page Header */
    .page-header {
        margin-bottom: 2rem;
        text-align: center;
    }

    .header-content {
        display: inline-flex;
        align-items: center;
        gap: 1.5rem;
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
        padding: 2rem 3rem;
        border-radius: 1.5rem;
        color: white;
        box-shadow: var(--shadow-lg);
    }

    .header-icon {
        width: 60px;
        height: 60px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        backdrop-filter: blur(10px);
    }

    .header-text h1 {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        text-align: left;
    }

    .header-text p {
        margin: 0.25rem 0 0;
        font-size: 1rem;
        opacity: 0.95;
        text-align: left;
    }

    /* Alerts */
    .alert-modern {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.5rem;
        border-radius: 0.75rem;
        margin-bottom: 2rem;
        box-shadow: var(--shadow-sm);
    }

    .alert-success {
        background: #f0fdf4;
        border-left: 4px solid var(--success-color);
        color: #166534;
    }

    .alert-danger {
        background: #fef2f2;
        border-left: 4px solid var(--danger-color);
        color: #991b1b;
    }

    .alert-modern i {
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .alert-content {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

        .alert-content strong {
            font-weight: 700;
        }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: white;
        border-radius: 1rem;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        box-shadow: var(--shadow-md);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
        }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.75rem;
        flex-shrink: 0;
    }

    .stat-info {
        flex: 1;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1;
        margin-bottom: 0.25rem;
    }

    .stat-label {
        font-size: 0.875rem;
        color: var(--text-secondary);
        font-weight: 500;
    }

    /* Table Card */
    .table-card {
        background: white;
        border-radius: 1.5rem;
        box-shadow: var(--shadow-lg);
        overflow: hidden;
    }

    .table-card-header {
        padding: 2rem;
        border-bottom: 2px solid var(--border-color);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .header-left h2 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-primary);
    }

    .header-left p {
        margin: 0.25rem 0 0;
        font-size: 0.875rem;
        color: var(--text-secondary);
    }

    .btn-primary-modern {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 0.95rem;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
        color: white;
        box-shadow: var(--shadow-sm);
    }

        .btn-primary-modern:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
        }

    /* Table */
    .table-responsive {
        overflow-x: auto;
    }

    .modern-table {
        width: 100%;
        border-collapse: collapse;
    }

        .modern-table thead {
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        }

        .modern-table th {
            padding: 1rem 1.5rem;
            text-align: left;
            font-weight: 600;
            font-size: 0.875rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-bottom: 2px solid var(--border-color);
        }

        .modern-table tbody tr {
            border-bottom: 1px solid var(--border-color);
            transition: background-color 0.2s ease;
        }

            .modern-table tbody tr:hover {
                background: #f8fafc;
            }

        .modern-table td {
            padding: 1.25rem 1.5rem;
            color: var(--text-primary);
        }

    /* Table Cell Styles */
    .request-id {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: 'Courier New', monospace;
        font-size: 0.875rem;
    }

        .request-id i {
            color: var(--text-secondary);
            font-size: 1rem;
        }

        .request-id code {
            background: #f1f5f9;
            padding: 0.25rem 0.5rem;
            border-radius: 0.375rem;
            font-weight: 600;
        }

    .request-title {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

        .request-title strong {
            font-weight: 600;
            color: var(--text-primary);
        }

        .request-title small {
            font-size: 0.8rem;
            color: var(--text-secondary);
        }

    .service-type-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.875rem;
        background: #f1f5f9;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--text-primary);
    }

        .service-type-badge i {
            color: var(--primary-color);
        }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.875rem;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .date-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
    }

        .date-info i {
            font-size: 1rem;
        }

    /* Action Buttons */
    .action-buttons {
        display: flex;
        gap: 0.5rem;
    }

    .btn-icon {
        width: 36px;
        height: 36px;
        border-radius: 0.5rem;
        border: 2px solid var(--border-color);
        background: white;
        color: var(--text-secondary);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 1rem;
    }

        .btn-icon:hover {
            background: var(--primary-color);
            border-color: var(--primary-color);
            color: white;
            transform: scale(1.05);
        }

    /* Empty State */
    .empty-state {
        background: white;
        border-radius: 1.5rem;
        padding: 4rem 2rem;
        text-align: center;
        box-shadow: var(--shadow-lg);
    }

    .empty-icon {
        width: 120px;
        height: 120px;
        margin: 0 auto 2rem;
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4rem;
        color: var(--text-secondary);
    }

    .empty-state h3 {
        margin: 0 0 1rem;
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text-primary);
    }

    .empty-state p {
        margin: 0 0 2rem;
        font-size: 1rem;
        color: var(--text-secondary);
        max-width: 500px;
        margin-left: auto;
        margin-right: auto;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .modern-status-container

    {
        padding: 1rem 0 2rem;
    }

    .header-content {
        flex-direction: column;
        padding: 1.5rem 2rem;
        gap: 1rem;
    }

    .header-text h1 {
        font-size: 1.5rem;
        text-align: center;
    }

    .header-text p {
        text-align: center;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .table-card-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .btn-primary-modern {
        width: 100%;
        justify-content: center;
    }

    .modern-table {
        font-size: 0.875rem;
    }

        .modern-table th,
        .modern-table td {
            padding: 0.75rem 0.5rem;
        }

        /* Stack table on mobile for better readability */
        .modern-table thead {
            display: none;
        }

        .modern-table tbody tr {
            display: block;
            margin-bottom: 1rem;
            border: 1px solid var(--border-color);
            border-radius: 0.75rem;
            overflow: hidden;
        }

        .modern-table td {
            display: flex;
            justify-content: space-between;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--border-color);
        }

            .modern-table td:last-child {
                border-bottom: none;
            }

            .modern-table td::before {
                content: attr(data-label);
                font-weight: 600;
                color: var(--text-secondary);
                text-transform: uppercase;
                font-size: 0.75rem;
                letter-spacing: 0.05em;
            }

    }
</style>

<script>
    function viewDetails(requestId) {
        // Implement view details functionality
        alert('View details for request: ' + requestId);
        // You can navigate to a details page or show a modal
        // window.location.href = '@Url.Action("Details", "ServiceRequest")/' + requestId;
    }
</script>

@functions {
    public class ServiceTypeInfo
    {
        public string Name { get; set; }
        public string Icon { get; set; }
    }

    public class StatusInfo
    {
        public string Name { get; set; }
        public string Icon { get; set; }
        public string Background { get; set; }
        public string Color { get; set; }
    }

    public ServiceTypeInfo GetServiceTypeInfo(ServiceType serviceType)
    {
        return serviceType switch
        {
            ServiceType.WasteCollection => new ServiceTypeInfo { Name = "Waste Collection", Icon = "trash" },
            ServiceType.RoadRepair => new ServiceTypeInfo { Name = "Road Repair", Icon = "cone-striped" },
            ServiceType.WaterIssue => new ServiceTypeInfo { Name = "Water Issue", Icon = "droplet" },
            ServiceType.Electricity => new ServiceTypeInfo { Name = "Electricity", Icon = "lightning-charge" },
            ServiceType.Sanitation => new ServiceTypeInfo { Name = "Sanitation", Icon = "shield-check" },
            ServiceType.Other => new ServiceTypeInfo { Name = "Other", Icon = "three-dots" },
            _ => new ServiceTypeInfo { Name = "Unknown", Icon = "question-circle" }
        };
    }

    public StatusInfo GetStatusInfo(RequestStatus status)
    {
        return status switch
        {
            RequestStatus.Submitted => new StatusInfo
            {
                Name = "Submitted",
                Icon = "send-check",
                Background = "linear-gradient(135deg, #10b981 0%, #059669 100%)",
                Color = "white"
            },
            RequestStatus.InProgress => new StatusInfo
            {
                Name = "In Progress",
                Icon = "arrow-repeat",
                Background = "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)",
                Color = "white"
            },
            RequestStatus.UnderReview => new StatusInfo
            {
                Name = "Under Review",
                Icon = "search",
                Background = "linear-gradient(135deg, #06b6d4 0%, #0891b2 100%)",
                Color = "white"
            },
            RequestStatus.Completed => new StatusInfo
            {
                Name = "Completed",
                Icon = "check-circle-fill",
                Background = "linear-gradient(135deg, #3b82f6 0%, #2563eb 100%)",
                Color = "white"
            },
            RequestStatus.Cancelled => new StatusInfo
            {
                Name = "Cancelled",
                Icon = "x-circle-fill",
                Background = "linear-gradient(135deg, #ef4444 0%, #dc2626 100%)",
                Color = "white"
            },
            _ => new StatusInfo
            {
                Name = "Unknown",
                Icon = "question-circle",
                Background = "#6c757d",
                Color = "white"
            }
        };
    }
}
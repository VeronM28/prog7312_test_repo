@model IEnumerable<ReportModel>
@{
    ViewData["Title"] = "My Reports";
}

<div class="modern-reports-container">
    <div class="container">
        <!-- Page Header -->
        <div class="page-header">
            <div class="header-content">
                <div class="header-icon">
                    <i class="bi bi-file-earmark-text-fill"></i>
                </div>
                <div class="header-text">
                    <h1>My Reports</h1>
                    <p>View and manage all your submitted reports</p>
                </div>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            var reportsList = Model.ToList();
            var totalReports = reportsList.Count;
            var pendingCount = reportsList.Count(r => r.Status == "Pending");
            var inProgressCount = reportsList.Count(r => r.Status == "In Progress");
            var resolvedCount = reportsList.Count(r => r.Status == "Resolved");

            <!-- Stats Summary -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);">
                        <i class="bi bi-collection"></i>
                    </div>
                    <div class="stat-info">
                        <div class="stat-value">@totalReports</div>
                        <div class="stat-label">Total Reports</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div class="stat-info">
                        <div class="stat-value">@pendingCount</div>
                        <div class="stat-label">Pending</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                    <div class="stat-info">
                        <div class="stat-value">@inProgressCount</div>
                        <div class="stat-label">In Progress</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="stat-info">
                        <div class="stat-value">@resolvedCount</div>
                        <div class="stat-label">Resolved</div>
                    </div>
                </div>
            </div>

            <!-- Reports Header with Actions -->
            <div class="reports-header">
                <div class="header-left">
                    <h2>Your Reports</h2>
                    <p>Showing @totalReports report@(totalReports != 1 ? "s" : "")</p>
                </div>
                <div class="header-right">
                    <a asp-action="Create" class="btn-primary-modern">
                        <i class="bi bi-plus-circle"></i>
                        <span>New Report</span>
                    </a>
                </div>
            </div>

            <!-- Reports Grid -->
            <div class="reports-grid">
                @foreach (var report in reportsList.OrderByDescending(r => r.DateSubmitted))
                {
                    <div class="report-card">
                        @if (!string.IsNullOrEmpty(report.ImagePath))
                        {
                            <div class="report-image">
                                <img src="@report.ImagePath" alt="Report Image">
                                <div class="image-overlay">
                                    <button class="view-image-btn" onclick="viewImage('@report.ImagePath')">
                                        <i class="bi bi-zoom-in"></i>
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="report-image-placeholder">
                                <i class="bi bi-image"></i>
                                <span>No Image</span>
                            </div>
                        }

                        <div class="report-content">
                            <!-- Badges Row -->
                            <div class="badges-row">
                                <span class="category-badge">
                                    <i class="bi bi-tag-fill"></i>
                                    @report.Category
                                </span>
                                @{
                                    var statusInfo = GetStatusBadge(report.Status);
                                }
                            <span class="status-badge" style="background: @statusInfo.Background; color: @statusInfo.Color;">
                                <i class="bi bi-@statusInfo.Icon"></i>
                                @report.Status
                            </span>
                        </div>

                        <!-- Location -->
                        <div class="report-location">
                            <i class="bi bi-geo-alt-fill"></i>
                            <h3>@report.Location</h3>
                        </div>

                        <!-- Description -->
                        <p class="report-description">
                            @(report.Description.Length > 120 ?
                                                    report.Description.Substring(0, 120) + "..." :
                                                    report.Description)
                    </p>

                            <!-- Footer Info -->
                            <div class="report-footer">
                                <div class="date-info">
                                    <i class="bi bi-calendar-event"></i>
                                    <span>@report.DateSubmitted.ToString("MMM dd, yyyy")</span>
                                </div>
                                <button class="btn-view-details" onclick="viewDetails('@report.Id')">
                                    <span>View Details</span>
                                    <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                        }
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-file-earmark-x"></i>
                </div>
                <h3>No Reports Yet</h3>
                <p>You haven't submitted any reports. Start making a difference by reporting issues in your community!</p>
                <a asp-action="Create" class="btn-primary-modern">
                    <i class="bi bi-plus-circle"></i>
                    <span>Submit First Report</span>
                </a>
            </div>
        }
    </div>
</div>

<!-- Image Modal -->
<div class="image-modal" id="imageModal" onclick="closeImageModal()">
    <div class="modal-content">
        <button class="close-modal" onclick="closeImageModal()">
            <i class="bi bi-x-lg"></i>
        </button>
        <img id="modalImage" src="" alt="Report Image">
    </div>
</div>

<style>
    :root {
        --primary-color: #6366f1;
        --primary-dark: #4f46e5;
        --primary-light: #818cf8;
        --secondary-color: #8b5cf6;
        --success-color: #10b981;
        --danger-color: #ef4444;
        --warning-color: #f59e0b;
        --info-color: #3b82f6;
        --bg-color: #f8fafc;
        --card-bg: #ffffff;
        --text-primary: #1e293b;
        --text-secondary: #64748b;
        --border-color: #e2e8f0;
        --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.07);
        --shadow-lg: 0 10px 25px rgba(0, 0, 0, 0.1);
    }

    .modern-reports-container {
        background: var(--bg-color);
        min-height: 100vh;
        padding: 2rem 0 4rem;
    }

    /* Page Header */
    .page-header {
        margin-bottom: 2rem;
        text-align: center;
    }

    .header-content {
        display: inline-flex;
        align-items: center;
        gap: 1.5rem;
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
        padding: 2rem 3rem;
        border-radius: 1.5rem;
        color: white;
        box-shadow: var(--shadow-lg);
    }

    .header-icon {
        width: 60px;
        height: 60px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        backdrop-filter: blur(10px);
    }

    .header-text h1 {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        text-align: left;
    }

    .header-text p {
        margin: 0.25rem 0 0;
        font-size: 1rem;
        opacity: 0.95;
        text-align: left;
    }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: white;
        border-radius: 1rem;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        box-shadow: var(--shadow-md);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
        }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.75rem;
        flex-shrink: 0;
    }

    .stat-info {
        flex: 1;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1;
        margin-bottom: 0.25rem;
    }

    .stat-label {
        font-size: 0.875rem;
        color: var(--text-secondary);
        font-weight: 500;
    }

    /* Reports Header */
    .reports-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding: 1.5rem 2rem;
        background: white;
        border-radius: 1rem;
        box-shadow: var(--shadow-md);
    }

    .header-left h2 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-primary);
    }

    .header-left p {
        margin: 0.25rem 0 0;
        font-size: 0.875rem;
        color: var(--text-secondary);
    }

    .btn-primary-modern {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 0.95rem;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
        color: white;
        box-shadow: var(--shadow-sm);
    }

        .btn-primary-modern:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
        }

    /* Reports Grid */
    .reports-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 2rem;
    }

    /* Report Card */
    .report-card {
        background: white;
        border-radius: 1.25rem;
        overflow: hidden;
        box-shadow: var(--shadow-md);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
    }

        .report-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-lg);
        }

    /* Report Image */
    .report-image {
        position: relative;
        width: 100%;
        height: 220px;
        overflow: hidden;
        background: #f1f5f9;
    }

        .report-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

    .report-card:hover .report-image img {
        transform: scale(1.05);
    }

    .image-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .report-card:hover .image-overlay {
        opacity: 1;
    }

    .view-image-btn {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: white;
        border: none;
        color: var(--primary-color);
        font-size: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .view-image-btn:hover {
            transform: scale(1.1);
            background: var(--primary-color);
            color: white;
        }

    .report-image-placeholder {
        width: 100%;
        height: 220px;
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: var(--text-secondary);
        gap: 0.5rem;
    }

        .report-image-placeholder i {
            font-size: 3rem;
        }

        .report-image-placeholder span {
            font-size: 0.875rem;
            font-weight: 500;
        }

    /* Report Content */
    .report-content {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        flex: 1;
    }

    .badges-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .category-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.375rem 0.875rem;
        background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary-color) 100%);
        color: white;
        border-radius: 0.5rem;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.375rem 0.875rem;
        border-radius: 0.5rem;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .report-location {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .report-location i {
            color: var(--primary-color);
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        .report-location h3 {
            margin: 0;
            font-size: 1.125rem;
            font-weight: 700;
            color: var(--text-primary);
            line-height: 1.4;
        }

    .report-description {
        margin: 0;
        color: var(--text-secondary);
        font-size: 0.9rem;
        line-height: 1.6;
        flex: 1;
    }

    /* Report Footer */
    .report-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 1rem;
        border-top: 2px solid var(--border-color);
        gap: 1rem;
    }

    .date-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
    }

        .date-info i {
            font-size: 1rem;
            color: var(--primary-color);
        }

    .btn-view-details {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.5rem 1rem;
        background: transparent;
        border: 2px solid var(--primary-color);
        border-radius: 0.5rem;
        color: var(--primary-color);
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .btn-view-details:hover {
            background: var(--primary-color);
            color: white;
            transform: translateX(4px);
        }

    /* Empty State */
    .empty-state {
        background: white;
        border-radius: 1.5rem;
        padding: 4rem 2rem;
        text-align: center;
        box-shadow: var(--shadow-lg);
    }

    .empty-icon {
        width: 120px;
        height: 120px;
        margin: 0 auto 2rem;
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4rem;
        color: var(--text-secondary);
    }

    .empty-state h3 {
        margin: 0 0 1rem;
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text-primary);
    }

    .empty-state p {
        margin: 0 0 2rem;
        font-size: 1rem;
        color: var(--text-secondary);
        max-width: 500px;
        margin-left: auto;
        margin-right: auto;
    }

    /* Image Modal */
    .image-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.9);
        z-index: 10000;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

        .image-modal.active {
            display: flex;
        }

    .modal-content {
        position: relative;
        max-width: 90vw;
        max-height: 90vh;
    }

        .modal-content img {
            max-width: 100%;
            max-height: 90vh;
            border-radius: 0.75rem;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
        }

    .close-modal {
        position: absolute;
        top: -50px;
        right: 0;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: white;
        border: none;
        color: var(--text-primary);
        font-size: 1.25rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

        .close-modal:hover {
            background: var(--danger-color);
            color: white;
            transform: scale(1.1);
        }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .modern-reports-container

    {
        padding: 1rem 0 2rem;
    }

    .header-content {
        flex-direction: column;
        padding: 1.5rem 2rem;
        gap: 1rem;
    }

    .header-text h1 {
        font-size: 1.5rem;
        text-align: center;
    }

    .header-text p {
        text-align: center;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .reports-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
    }

    .btn-primary-modern {
        width: 100%;
        justify-content: center;
    }

    .reports-grid {
        grid-template-columns: 1fr;
    }

    .report-footer {
        flex-direction: column;
        align-items: flex-start;
    }

    .btn-view-details {
        width: 100%;
        justify-content: center;
    }

    }
</style>

<script>
    function viewImage(imagePath) {
        event.stopPropagation();
        const modal = document.getElementById('imageModal');
        const modalImage = document.getElementById('modalImage');
        modalImage.src = imagePath;
        modal.classList.add('active');
    }

    function closeImageModal() {
        const modal = document.getElementById('imageModal');
        modal.classList.remove('active');
    }

    function viewDetails(reportId) {
        // Implement view details functionality
        alert('View details for report ID: ' + reportId);
        // You can navigate to a details page
        // window.location.href = '@Url.Action("Details", "Report")/' + reportId;
    }

    // Close modal on Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeImageModal();
        }
    });
</script>

@functions {
    public class StatusBadgeInfo
    {
        public string Background { get; set; }
        public string Color { get; set; }
        public string Icon { get; set; }
    }

    public StatusBadgeInfo GetStatusBadge(string status)
    {
        return status switch
        {
            "Pending" => new StatusBadgeInfo
            {
                Background = "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)",
                Color = "white",
                Icon = "hourglass-split"
            },
            "Submitted" => new StatusBadgeInfo
            {
                Background = "linear-gradient(135deg, #10b981 0%, #059669 100%)",
                Color = "white",
                Icon = "send-check"
            },
            "In Progress" => new StatusBadgeInfo
            {
                Background = "linear-gradient(135deg, #3b82f6 0%, #2563eb 100%)",
                Color = "white",
                Icon = "arrow-repeat"
            },
            "Resolved" => new StatusBadgeInfo
            {
                Background = "linear-gradient(135deg, #10b981 0%, #059669 100%)",
                Color = "white",
                Icon = "check-circle-fill"
            },
            "Completed" => new StatusBadgeInfo
            {
                Background = "linear-gradient(135deg, #10b981 0%, #059669 100%)",
                Color = "white",
                Icon = "check-circle-fill"
            },
            _ => new StatusBadgeInfo
            {
                Background = "#6c757d",
                Color = "white",
                Icon = "question-circle"
            }
        };
    }
}